#!/bin/bash -eu

# config: Manage SSH config entries for Vault-signed certificates
#
# Usage:
#   config add [--pattern PATTERN] [--ssh-config PATH]
#   config list [--ssh-config PATH]
#   config refresh [--pattern PATTERN] [--ssh-config PATH]
#   config remove --pattern PATTERN [--ssh-config PATH]
#
# Commands:
#   add      Add a host pattern to SSH config (interactive if --pattern not given)
#   list     List all cssh-managed host patterns
#   refresh  Rewrite managed blocks from the current environment (all blocks
#            unless --pattern is given)
#   remove   Remove a host pattern from SSH config
#
# Options:
#   --pattern PATTERN    Host pattern (e.g., "*.example.com")
#   --ssh-config PATH    SSH config file (default: $CSSH_SSH_CONFIG or ~/.ssh/config)
#
# Refresh regenerates the Match line and the CertificateFile, IdentityFile and
# IdentitiesOnly options from SSH_PUBLIC_KEY_PATH and CSSH_CACHE_DIR. Use it
# after changing your key, or on a machine whose configuration was copied from
# another. Any other option you added to a block by hand, such as "User ci", is
# preserved in place.

HERE=$(cd "$(dirname "$0")" && pwd)
readonly HERE

# Colors (only if terminal supports them)
if [[ -t 1 ]]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[0;33m'
  NC='\033[0m'
else
  RED=''
  GREEN=''
  YELLOW=''
  NC=''
fi

fail() {
  echo -e "${RED}error:${NC} $*" >&2
  exit 1
}

warn() {
  echo -e "${YELLOW}warning:${NC} $*" >&2
}

usage() {
  head -26 "$0" | tail -24
  exit "${1:-0}"
}

# Options this script owns inside a managed block, in the order `add` writes
# them. Everything else in a block belongs to whoever put it there.
readonly MANAGED_KEYS="CertificateFile IdentityFile IdentitiesOnly"

is_managed_key() {
  case " ${MANAGED_KEYS} " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

# Derive the managed paths from the environment. Sets CERT_PATH, PRIVATE_KEY
# and ENSURE_CERT_PATH.
derive_paths() {
  if [[ -z "${SSH_PUBLIC_KEY_PATH:-}" ]]; then
    fail "SSH_PUBLIC_KEY_PATH not set. Run 'install' first or source ~/.profile.d/cssh"
  fi

  local key_basename key_name cache_dir
  key_basename=$(basename "${SSH_PUBLIC_KEY_PATH}")
  key_name="${key_basename%.pub}"
  cache_dir="${CSSH_CACHE_DIR:-${HOME}/.cache/cssh}"

  CERT_PATH="${cache_dir}/${key_name}-cert.pub"
  PRIVATE_KEY="${SSH_PUBLIC_KEY_PATH%.pub}"
  ENSURE_CERT_PATH="${HERE}/ensure-cert"
}

# Current value for a managed option. Requires derive_paths.
managed_value() {
  case "$1" in
    CertificateFile) echo "${CERT_PATH}" ;;
    IdentityFile) echo "${PRIVATE_KEY}" ;;
    IdentitiesOnly) echo "yes" ;;
    *) fail "not a managed option: $1" ;;
  esac
}

# Get SSH config path (argument > env var > default)
get_ssh_config_path() {
  local arg_path="$1"

  if [[ -n "${arg_path}" ]]; then
    echo "${arg_path}"
  elif [[ -n "${CSSH_SSH_CONFIG:-}" ]]; then
    echo "${CSSH_SSH_CONFIG}"
  else
    echo "${HOME}/.ssh/config"
  fi
}

# Ensure SSH config file and directory exist with correct permissions
ensure_ssh_config() {
  local config_path="$1"
  local ssh_dir
  ssh_dir=$(dirname "${config_path}")

  if [[ ! -d "${ssh_dir}" ]]; then
    echo "Creating ${ssh_dir}"
    mkdir -p "${ssh_dir}"
    chmod 700 "${ssh_dir}"
  fi

  if [[ ! -f "${config_path}" ]]; then
    echo "Creating ${config_path}"
    touch "${config_path}"
    chmod 600 "${config_path}"
  fi
}

# Check if a pattern already exists in SSH config
pattern_exists() {
  local config_path="$1"
  local pattern="$2"

  if [[ ! -f "${config_path}" ]]; then
    return 1
  fi

  # Fixed-string whole-line match: host patterns contain regex metacharacters
  grep -Fxq "# cssh-managed: ${pattern}" "${config_path}" 2>/dev/null
}

# Prompt for yes/no
confirm() {
  local prompt_text="$1"
  local default="${2:-n}"

  local yn_hint
  if [[ "${default}" == "y" ]]; then
    yn_hint="[Y/n]"
  else
    yn_hint="[y/N]"
  fi

  local response
  read -r -p "${prompt_text} ${yn_hint}: " response
  response="${response:-${default}}"

  case "${response}" in
    [yY]|[yY][eE][sS]) return 0 ;;
    *) return 1 ;;
  esac
}

# Add command
cmd_add() {
  local config_path=""
  local pattern=""

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pattern)
        pattern="$2"
        shift 2
        ;;
      --ssh-config)
        config_path="$2"
        shift 2
        ;;
      --help|-h)
        usage 0
        ;;
      *)
        fail "unknown option: $1"
        ;;
    esac
  done

  config_path=$(get_ssh_config_path "${config_path}")

  derive_paths

  # Interactive mode if pattern not provided
  if [[ -z "${pattern}" ]]; then
    read -r -p "Host pattern (e.g., *.example.com): " pattern
  fi

  if [[ -z "${pattern}" ]]; then
    fail "host pattern is required"
  fi

  # Check for duplicate
  if pattern_exists "${config_path}" "${pattern}"; then
    fail "pattern '${pattern}' already exists in ${config_path}"
  fi

  # Summary
  echo
  echo "Configuration summary:"
  echo "  SSH config file:  ${config_path}"
  echo "  Host pattern:     ${pattern}"
  echo "  Certificate:      ${CERT_PATH}"
  echo "  Private key:      ${PRIVATE_KEY}"
  echo "  Match exec cmd:   ${ENSURE_CERT_PATH} --quiet"
  echo

  if ! confirm "Add this configuration?"; then
    echo "Aborted."
    exit 0
  fi

  # Ensure config file exists
  ensure_ssh_config "${config_path}"

  # Append configuration block
  cat >> "${config_path}" <<EOF

# cssh-managed: ${pattern}
Match host ${pattern} exec "${ENSURE_CERT_PATH} --quiet"
    CertificateFile ${CERT_PATH}
    IdentityFile ${PRIVATE_KEY}
    IdentitiesOnly yes
EOF

  echo -e "${GREEN}Added configuration for '${pattern}' to ${config_path}${NC}"
}

# List command
cmd_list() {
  local config_path=""

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ssh-config)
        config_path="$2"
        shift 2
        ;;
      --help|-h)
        usage 0
        ;;
      *)
        fail "unknown option: $1"
        ;;
    esac
  done

  config_path=$(get_ssh_config_path "${config_path}")

  if [[ ! -f "${config_path}" ]]; then
    echo "No SSH config file found at ${config_path}"
    exit 0
  fi

  local patterns
  patterns=$(grep "^# cssh-managed:" "${config_path}" 2>/dev/null | sed 's/^# cssh-managed: //' || true)

  if [[ -z "${patterns}" ]]; then
    echo "No cssh-managed patterns found in ${config_path}"
  else
    echo "cssh-managed patterns in ${config_path}:"
    echo "${patterns}" | while read -r p; do
      echo "  ${p}"
    done
  fi
}

# Append the managed options a block did not already carry
flush_managed_options() {
  local tmp_file="$1"
  local seen="$2"
  local managed

  for managed in ${MANAGED_KEYS}; do
    case " ${seen} " in
      *" ${managed} "*) continue ;;
    esac
    printf '    %s %s\n' "${managed}" "$(managed_value "${managed}")" >> "${tmp_file}"
  done
}

# Walk the config applying MODE ("remove" or "refresh") to every managed block
# matching PATTERN, writing the result to TMP_FILE. An empty PATTERN matches
# every block. The original is not modified.
#
# A block is the "# cssh-managed:" marker, the Match line directly below it,
# and every indented option line after that, ending at the first line which is
# not an indented option. Refresh rewrites the Match line and the managed
# options in place and leaves every other line where it is.
rewrite_config() {
  local mode="$1"
  local pattern="$2"
  local config_path="$3"
  local tmp_file="$4"

  # 0 = outside a block, 1 = the Match line comes next, 2 = inside the options
  local state=0
  local block_pattern=""
  local seen=""
  local pending_blank=0
  local line key

  while IFS= read -r line || [[ -n "${line}" ]]; do
    # Inside a block, an indented non-empty line is one of its options
    if [[ ${state} -eq 2 ]]; then
      case "${line}" in
        [[:space:]]*[![:space:]]*)
          if [[ "${mode}" == "remove" ]]; then
            continue
          fi
          read -r key _ <<< "${line}"
          if is_managed_key "${key}"; then
            printf '    %s %s\n' "${key}" "$(managed_value "${key}")" >> "${tmp_file}"
            seen="${seen} ${key}"
          else
            echo "${line}" >> "${tmp_file}"
          fi
          continue
          ;;
      esac

      if [[ "${mode}" == "refresh" ]]; then
        flush_managed_options "${tmp_file}" "${seen}"
      fi
      state=0
      seen=""
    fi

    # The line directly below a marker is the block's Match line
    if [[ ${state} -eq 1 ]]; then
      if [[ "${line}" == "Match "* ]]; then
        state=2
        if [[ "${mode}" == "refresh" ]]; then
          printf 'Match host %s exec "%s --quiet"\n' \
            "${block_pattern}" "${ENSURE_CERT_PATH}" >> "${tmp_file}"
        fi
        continue
      fi
      warn "block '${block_pattern}' has no Match line; leaving its contents alone"
      state=0
    fi

    if [[ "${line}" == "# cssh-managed: "* ]]; then
      block_pattern="${line#\# cssh-managed: }"
      if [[ -z "${pattern}" ]] || [[ "${block_pattern}" == "${pattern}" ]]; then
        state=1
        seen=""
        if [[ "${mode}" == "remove" ]]; then
          # Drop the blank line that `add` wrote above the marker
          pending_blank=0
          continue
        fi
      fi
    fi

    # Hold blank lines so a removed block does not leave a gap behind
    if [[ -z "${line}" ]]; then
      pending_blank=1
      continue
    fi

    if [[ ${pending_blank} -eq 1 ]]; then
      echo "" >> "${tmp_file}"
      pending_blank=0
    fi
    echo "${line}" >> "${tmp_file}"
  done < "${config_path}"

  # The file may end inside a block
  if [[ ${state} -eq 2 ]] && [[ "${mode}" == "refresh" ]]; then
    flush_managed_options "${tmp_file}" "${seen}"
  fi

  if [[ ${pending_blank} -eq 1 ]]; then
    echo "" >> "${tmp_file}"
  fi
}

# Remove command
cmd_remove() {
  local config_path=""
  local pattern=""

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pattern)
        pattern="$2"
        shift 2
        ;;
      --ssh-config)
        config_path="$2"
        shift 2
        ;;
      --help|-h)
        usage 0
        ;;
      *)
        fail "unknown option: $1"
        ;;
    esac
  done

  config_path=$(get_ssh_config_path "${config_path}")

  if [[ -z "${pattern}" ]]; then
    fail "--pattern is required for remove command"
  fi

  if [[ ! -f "${config_path}" ]]; then
    fail "SSH config file not found: ${config_path}"
  fi

  if ! pattern_exists "${config_path}" "${pattern}"; then
    fail "pattern '${pattern}' not found in ${config_path}"
  fi

  # Create temp file for new config
  local tmp_file
  tmp_file=$(mktemp)
  trap 'rm -f "${tmp_file}"' RETURN

  # Generate new config without the pattern
  rewrite_config remove "${pattern}" "${config_path}" "${tmp_file}"

  # Show diff of what will be removed
  echo "Changes to ${config_path}:"
  echo
  diff --color=auto -u "${config_path}" "${tmp_file}" || true
  echo

  if ! confirm "Apply these changes?"; then
    echo "Aborted."
    exit 0
  fi

  # Replace original file
  cp "${tmp_file}" "${config_path}"
  chmod 600 "${config_path}"

  echo -e "${GREEN}Removed configuration for '${pattern}' from ${config_path}${NC}"
}

# Refresh command
cmd_refresh() {
  local config_path=""
  local pattern=""

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pattern)
        pattern="$2"
        shift 2
        ;;
      --ssh-config)
        config_path="$2"
        shift 2
        ;;
      --help|-h)
        usage 0
        ;;
      *)
        fail "unknown option: $1"
        ;;
    esac
  done

  config_path=$(get_ssh_config_path "${config_path}")

  if [[ ! -f "${config_path}" ]]; then
    fail "SSH config file not found: ${config_path}"
  fi

  if ! grep -q "^# cssh-managed:" "${config_path}" 2>/dev/null; then
    echo "No cssh-managed patterns found in ${config_path}"
    exit 0
  fi

  if [[ -n "${pattern}" ]] && ! pattern_exists "${config_path}" "${pattern}"; then
    fail "pattern '${pattern}' not found in ${config_path}"
  fi

  derive_paths

  if [[ ! -f "${SSH_PUBLIC_KEY_PATH}" ]]; then
    warn "SSH public key not found: ${SSH_PUBLIC_KEY_PATH}"
  fi

  echo
  echo "Refreshing from:"
  echo "  SSH config file:  ${config_path}"
  if [[ -n "${pattern}" ]]; then
    echo "  Host pattern:     ${pattern}"
  else
    echo "  Host pattern:     (all managed blocks)"
  fi
  echo "  Certificate:      ${CERT_PATH}"
  echo "  Private key:      ${PRIVATE_KEY}"
  echo "  Match exec cmd:   ${ENSURE_CERT_PATH} --quiet"
  echo

  local tmp_file
  tmp_file=$(mktemp)
  trap 'rm -f "${tmp_file}"' RETURN

  rewrite_config refresh "${pattern}" "${config_path}" "${tmp_file}"

  if cmp -s "${config_path}" "${tmp_file}"; then
    echo -e "${GREEN}Already up to date.${NC}"
    exit 0
  fi

  echo "Changes to ${config_path}:"
  echo
  diff --color=auto -u "${config_path}" "${tmp_file}" || true
  echo

  if ! confirm "Apply these changes?"; then
    echo "Aborted."
    exit 0
  fi

  cp "${tmp_file}" "${config_path}"
  chmod 600 "${config_path}"

  echo -e "${GREEN}Refreshed ${config_path}${NC}"
}

# Main
case "${1:-}" in
  add)
    shift
    cmd_add "$@"
    ;;
  list)
    shift
    cmd_list "$@"
    ;;
  refresh)
    shift
    cmd_refresh "$@"
    ;;
  remove)
    shift
    cmd_remove "$@"
    ;;
  --help|-h)
    usage 0
    ;;
  "")
    usage 1
    ;;
  *)
    fail "unknown command: $1"
    ;;
esac
